        {
          "name": "Refresh Token - Renovación",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Nuevo accessToken\", function () {",
                  "    pm.expect(jsonData.accessToken).to.exist;",
                  "    pm.expect(jsonData.accessToken).to.not.eql(pm.collectionVariables.get(\"access_token\"));",
                  "});",
                  "pm.test(\"Nuevo refreshToken (rotación)\", function () {",
                  "    pm.expect(jsonData.refreshToken).to.exist;",
                  "    pm.expect(jsonData.refreshToken).to.not.eql(pm.collectionVariables.get(\"refresh_token\"));",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"access_token\", jsonData.accessToken);",
                  "pm.collectionVariables.set(\"refresh_token\", jsonData.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
