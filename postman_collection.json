    {
      "name": "6. Flujo Completo (demostración)",
      "item": [
        {
          "name": "Paso 1 - Login Admin y obtener tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"access_token\", jsonData.accessToken);",
                  "pm.collectionVariables.set(\"refresh_token\", jsonData.refreshToken);",
                  "pm.collectionVariables.set(\"admin_token\", jsonData.accessToken);",
                  "console.log(\"Access Token guardado\");",
                  "console.log(\"Refresh Token guardado\");"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@helpdesk.com\",\"password\":\"admin123\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Paso 2 - Refresh Token (rotación)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"access_token\", jsonData.accessToken);",
                  "pm.collectionVariables.set(\"refresh_token\", jsonData.refreshToken);",
                  "console.log(\"Nuevo Access Token por refresh\");"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"refreshToken\":\"{{refresh_token}}\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Paso 3 - Crear Ticket con SLA",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"ticket_id\", jsonData.id);",
                  "console.log(\"Ticket creado: \" + jsonData.id);",
                  "console.log(\"SLA vence: \" + jsonData.slaVenceEn);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"titulo\":\"Demo SLA ALTA\",\"descripcion\":\"Ticket de demostración con prioridad ALTA (SLA 4h)\",\"prioridad\":\"ALTA\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/tickets",
              "host": ["{{base_url}}"],
              "path": ["api", "tickets"]
            }
          }
        },
        {
          "name": "Paso 4 - Ver Tickets Vencidos (SOPORTE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "console.log(\"Tickets vencidos encontrados: \" + jsonData.length);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{soporte_token}}"}],
            "url": {
              "raw": "{{base_url}}/api/tickets/vencidos",
              "host": ["{{base_url}}"],
              "path": ["api", "tickets", "vencidos"]
            }
          }
        },
        {
          "name": "Paso 5 - Logout y verificar revocación",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "console.log(\"Sesión cerrada. El refresh token fue revocado.\");",
                  "console.log(\"El siguiente request a /api/auth/refresh con este token debe fallar con 401.\");"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    }
